# -------LLM------------
OPENAI_CHAT_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_API_KEY=sk-换成你自己的
OPENAI_CHAT_MODEL=gpt-4o

# ------EMBEDDING--------
# ⚠️ 键名必须和 ragkit/config.py 里的字段名严格对应（pydantic-settings 会自动转大写）。
# 漏写前缀（比如写成 EMBEDDING_MODEL）不会报错，只会被 extra="ignore" 静默忽略，
# 然后你会莫名其妙地用上代码里的默认值。
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_API_KEY=sk-换成你自己的
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# ------MILVUS-----------
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=ragkit_chunks
