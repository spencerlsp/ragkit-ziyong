# ---------- LLM（生成答案）：DeepSeek 官方 ----------
# 任何 OpenAI 兼容端点都能接，换供应商只改这三行。
OPENAI_CHAT_BASE_URL=https://api.deepseek.com
OPENAI_CHAT_API_KEY=sk-换成你自己的
OPENAI_CHAT_MODEL=deepseek-chat

# ---------- Embedding（向量化）：硅基流动 ----------
# ⚠️ 键名必须和 ragkit/config.py 里的字段名严格对应（pydantic-settings 会自动转大写）。
# 漏写前缀（比如写成 EMBEDDING_MODEL）不会报错，只会被 extra="ignore" 静默忽略，
# 然后你会莫名其妙地用上代码里的默认值。
OPENAI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_EMBEDDING_API_KEY=sk-换成你自己的
OPENAI_EMBEDDING_MODEL=BAAI/bge-m3
OPENAI_EMBEDDING_DIM=1024
OPENAI_EMBEDDING_BATCH_SIZE=32

# ---------- 重排（rerank）----------
# ⚠️ rerank 不是 OpenAI 兼容协议的一部分，字段名各家不同，
# 所以它单独一组配置，不复用上面的 OPENAI_EMBEDDING_*。
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=sk-换成你自己的
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------- Milvus ----------
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DB=
MILVUS_COLLECTION=ragkit_chunks
